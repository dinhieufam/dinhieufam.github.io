@inproceedings{pham2026tcsrmonitor,
  abbr        = {UNSURE '26},
  title       = {Beyond Uncertainty: Generalizable Failure Monitoring for Surgical Segmentation under Acquisition Degradation},
  author      = {Pham, Hieu D. and Cao, Dang P. M. and Huynh, Thanh Trung},
  booktitle   = {UNSURE Workshop, MICCAI},
  year        = {2026},
  abstract    = {We propose TCSR-Monitor, a post-hoc failure monitoring framework that goes beyond uncertainty estimates by incorporating complementary observable signals such as shape, temporal consistency, and image quality. The framework operates without access to model internals or ground truth during deployment and generalizes to unseen acquisition degradations, helping make AI systems more reliable in real surgical environments.},
  arxiv       = {2608.16748},
  code        = {https://github.com/dinhieufam/tcsr-monitor},
  selected    = {true}
}

@inproceedings{cao2026oracleconditioning,
  abbr        = {FAIMI/BRIDGE/EPIMI '26},
  title       = {When Oracle Conditioning Misleads Deployment: Conditioning-Availability Bias in Echocardiographic Segmentation},
  author      = {Cao, Dang P. M. and Pham, Hieu D. and Pham, Hieu},
  booktitle   = {FAIMI/BRIDGE/EPIMI Workshop, MICCAI},
  year        = {2026},
  abstract    = {This work highlights a deployment issue that often goes unnoticed: models are frequently evaluated using auxiliary information that will not actually be available in practice. We introduce a simple audit framework to expose this conditioning-availability bias, showing how oracle-conditioned evaluation can substantially overestimate real-world performance and fairness.},
  arxiv       = {2608.03342},
  code        = {https://github.com/minhdang050806/Oracle-Conditioning-Bias-in-Echocardiographic-Segmentation},
  selected    = {true}
}

